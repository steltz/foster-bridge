# --- Firebase / GCP (ADC-only; NO service-account key files) ---
# Credentials are NOT set here. Authenticate with:
#   gcloud auth application-default login
# and the firebase-admin SDK resolves ADC automatically.

# GCP / Firebase project id
FIREBASE_PROJECT_ID=app-foster-bridge

# Firebase Storage bucket
FIREBASE_STORAGE_BUCKET=app-foster-bridge.firebasestorage.app

# HTTP port
PORT=3000

# Active LLM provider at the swap seam (llm.module.ts): 'anthropic' or 'moonshot'.
LLM_PROVIDER=anthropic

# --- Anthropic / Claude API ---
# API key is read by the SDK. NOT committed; add it here when you have one.
# Until then the app boots fine and GET /ai/ready reports { "configured": false }.
ANTHROPIC_API_KEY=

# Default model (env-overridable). See the claude-api guidance for options.
ANTHROPIC_MODEL=claude-sonnet-5

# Default max output tokens per request. 4096 is a demo-friendly value; the API
# guidance is ~16000 for real non-streaming workloads.
ANTHROPIC_MAX_TOKENS=4096

# Moonshot / Kimi provider (set LLM_PROVIDER=moonshot to activate)
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_MODEL=kimi-k3
MOONSHOT_MAX_TOKENS=32000
MOONSHOT_BATCH_CONCURRENCY=8
MOONSHOT_COMPLETION_WINDOW=1d
MOONSHOT_BATCH_MAX_AGE_MS=10800000
MOONSHOT_BATCH_GC_TTL_MS=86400000

# --- EminiPlayer scraper (Playwright) ---
# Credentials for eminiplayer.net. NOT committed; required only when the
# archive page needs a login.
EMINIPLAYER_USERNAME=
EMINIPLAYER_PASSWORD=
# Set to false to watch the browser locally.
EMINIPLAYER_HEADLESS=true
# Where archive-page screenshots land (default: backend/artifacts/eminiplayer)
EMINIPLAYER_SCREENSHOT_DIR=
# Model for LLM transcript verification (unset = provider default model).
# On moonshot, kimi-k2.6 is the cheap pick — the verify call runs it with
# reasoning disabled (effort 'none'), which it needs to fit maxTokens 300.
EMINIPLAYER_VERIFY_MODEL=
# Pause (ms) between bulk-backfill days that touched the network. Default 2000.
EMINIPLAYER_BACKFILL_DELAY_MS=
# Per-day ceiling (ms) for a bulk-backfill day; a timeout becomes a 'stage'
# ledger entry instead of wedging the job. Default 600000 (10 min).
EMINIPLAYER_BACKFILL_DAY_TIMEOUT_MS=
# Optional shared secret: when set, POST/DELETE /eminiplayer/backfill require
# a matching x-backfill-token header.
EMINIPLAYER_BACKFILL_TOKEN=
# Circuit breaker: abort the job after N consecutive stage failures (a broken
# session/YouTube throttle must not burn the remaining thousands of days).
# Default 20.
EMINIPLAYER_BACKFILL_MAX_CONSECUTIVE_STAGE_FAILURES=
